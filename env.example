# Copie este arquivo para .env e informe sua própria chave.
GOOGLE_API_KEY=COLOQUE_SUA_CHAVE_GEMINI_AQUI

# Modelo de chat já testado no projeto.
GEMINI_MODEL=gemini-3.6-flash

# Modelo de embeddings usado para indexar os PDFs OSO.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Fuso do servidor MCP comunitário.
MCP_TIMEZONE=America/Fortaleza

# Banco SQLite do checkpointer (caminho relativo à raiz do projeto).
LANGGRAPH_CHECKPOINT_DB=dados/memoria/conversas.sqlite
